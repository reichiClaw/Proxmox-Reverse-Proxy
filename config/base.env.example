# Copy to base.env and adjust. Used by scripts/add-service.sh.
# Traefik itself reads hostnames already rendered into dynamic YAML.

# Base domain for all service subdomains: <name>.${DOMAIN}
DOMAIN=example.com

# ACME account email (Let's Encrypt)
ACME_EMAIL=admin@example.com

# Optional: override generated file directory
# APPS_DIR=config/dynamic/apps
