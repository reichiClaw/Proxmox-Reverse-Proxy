# Cloudflare DNS automation — copy to cloudflare.env (chmod 600).
# Easier: configure via the Gate GUI → Settings → Cloudflare DNS automation.
# Full setup guide: README.md → "Cloudflare DNS integration".

# API token with permissions: Zone → Zone → Read AND Zone → DNS → Edit,
# scoped to exactly the zones you publish services under.
CF_API_TOKEN=

# The DNS name that already resolves to this gate (an existing A/AAAA or
# DDNS record). Every service CNAME points here.
CF_TARGET=gate.example.com

# false = DNS-only (grey cloud, recommended). true = proxied (orange cloud);
# read the README caveats about ACME and Proxmox consoles first.
CF_PROXIED=false
